GAL16V8
mul
CLK A0 A1 A2 A3 B0 B1 B2 B3 GND;
/OE Y0 Y1 P0 P1 P2 P3 Y2 Y3 VCC;
Y0 = A0 * B0;
Y1 = /A0 * A1 * B0 + A1 * B0 * /B1 + A0 * /A1 * B1 + A0 * /B0 * B1;
P0 = A0 * A2 * B0 * /B2 + A0 * /A2 * B0 * B2 + A1 * /B0 * B1 * /B2 + A0 * /A1 * /B0 * B2 + /A0 * A2 * B0 * /B1 + /A0 * A1 * /A2 * B1 + A0 * /B0 * /B1 * B2;
Y2 = P0 + /A0 * /A1 * A2 * B0 + /A0 * A1 * /B0 * B1;
P1 = A0*/A2*/B0*B1*B3 + /A0*A1*/A3*B0*B2 + /A0*A1*A3*B0*/B2 + A0*A2*/B0*B1*/B3 + /A0*A1*/A2*/B0*B2 + /A1*/A2*A3*B0*/B3 + /A0*/A1*A2*/A3*B1;
P2 = A0 * /A1 * /A2 * /A3 * B3 + /A0 * /A1 * A2 * /B0 * B1 + A0 * /B0 * /B1 * /B2 * B3 + /A0 * /A1 * /A2 * A3 * B0 + A1 * /B0 * /B1 * B2 * /B3 + A3 * B0 * /B1 * /B2 * /B3 + /A0 * /A1 * A3 * B0 * /B1;
P3 = A0 * /A3 * /B1 * /B2 * B3 + A0 * /A1 * /B0 * /B1 * B3 + A0 * A1 * A2 * /A3 * B0 * B3 + A0 * A1 * A2 * A3 * B0 * /B3 + A0 * /A3 * B0 * B1 * B2 * B3 + A0 * A3 * B0 * B1 * B2 * /B3 + A1 * /A2 * /A3 * /B1 * B2 * /B3;
Y3 = P1 + /A0*A1*/B0*/B1*B2 + P2 + /A0 * A2 * /B0 * B1 * /B2 + P3 + /A1 * A2 * /A3 * B1 * /B2 * /B3 + /A1 * A2 * A3 * B0 * /B1 * B2 * B3;
